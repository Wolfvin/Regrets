+#!/usr/bin/env python3
+"""
+Pure logic extracted from Brainloller class.
+No I/O, no class state — pure functions only.
+"""
+
+COMMANDS = {
+    (255, 0, 0): ">",
+    (128, 0, 0): "<",
+    (0, 255, 0): "+",
+    (0, 128, 0): "-",
+    (0, 0, 255): ".",
+    (0, 0, 128): ",",
+    (255, 255, 0): "[",
+    (128, 128, 0): "]",
+    (0, 255, 255): "R",
+    (0, 128, 128): "L",
+}
+
+COMMANDS_REVERSE = dict(zip(COMMANDS.values(), COMMANDS.keys()))
+COMMANDS_REVERSE.pop("R")
+COMMANDS_REVERSE.pop("L")
+
+
+def to_brainfuck(pixels, width, height):
+    """
+    Convert Brainloller image pixels to a Brainfuck program string.
+
+    Args:
+        pixels: 2D list of (R, G, B) tuples.
+        width: Image width.
+        height: Image height.
+
+    Returns:
+        A Brainfuck program string.
+    """
+    program = []
+    pcX = 0
+    pcY = 0
+    NORTH, EAST, SOUTH, WEST = range(4)
+    way = EAST
+
+    while (0 <= pcX < width) and (0 <= pcY < height):
+        colour = pixels[pcY][pcX]
+        command = COMMANDS.get(colour)
+
+        if command == "R":
+            way = (way + 1) % 4
+        elif command == "L":
+            way = (way - 1) % 4
+        elif command is not None:
+            program.append(command)
+
+        if way == EAST:
+            pcX += 1
+        elif way == SOUTH:
+            pcY += 1
+        elif way == WEST:
+            pcX -= 1
+        else:
+            pcY -= 1
+
+    return "".join(program)
+
+
+def to_brainloller(program):
+    """
+    Convert a Brainfuck program string to Brainloller image pixels.
+
+    Args:
+        program: A Brainfuck program string.
+
+    Returns:
+        A dict with 'pixels' (2D list of RGB tuples) and 'width' and 'height'.
+    """
+    res = []
+    for command in program:
+        try:
+            res.append(COMMANDS_REVERSE[command])
+        except KeyError:
+            continue
+
+    return {"pixels": [res], "width": len(res), "height": 1 if res else 0}
