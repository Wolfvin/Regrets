--- /dev/null
+++ b/pyfuck/brainfuck_logic.py
@@ -0,0 +1,129 @@
+#!/usr/bin/env python3
+"""
+Pure logic extracted from Brainfuck class.
+No I/O, no terminal dependencies, no class state — pure functions only.
+"""
+
+from collections import namedtuple
+
+
+COMMANDS = "<>+-.,[]"
+
+
+def preprocess(source):
+    """
+    Preprocess a Brainfuck program, splitting on '!' separator.
+
+    Args:
+        source: A string with Brainfuck program (may include '!' separator for input).
+
+    Returns:
+        A dict with 'program' and 'input' keys (namedtuple is not JSON-serializable).
+    """
+    try:
+        prog, inp = source.split("!", 1)
+    except ValueError:
+        prog = source
+        inp = ""
+    return {"program": prog, "input": inp}
+
+
+def compile_program(program):
+    """
+    Compile Brainfuck code into internal representation.
+
+    Args:
+        program: A string with Brainfuck program (commands only, no input section).
+
+    Returns:
+        A list of [command, jump_destination] pairs.
+    """
+    skipped = 0
+    compiled = []
+    stack = []
+
+    for pos, command in enumerate(program):
+        if command not in COMMANDS:
+            skipped += 1
+            continue
+
+        if command == "[":
+            stack.append(pos - skipped)
+            compiled.append([command, 0])
+
+        elif command == "]":
+            _ = stack.pop()
+            compiled.append([command, _])
+            compiled[_][1] = pos - skipped
+
+        else:
+            compiled.append([command, 0])
+
+    return compiled
+
+
+def eval_to_output(program, stdin_input=""):
+    """
+    Evaluate a Brainfuck program and return the output as a string.
+    Pure function version — no terminal I/O, returns result directly.
+
+    Args:
+        program: A string with Brainfuck program.
+        stdin_input: Optional input string for ',' commands.
+
+    Returns:
+        The output string produced by the program.
+    """
+    preprocessed = preprocess(program)
+    compiled = compile_program(preprocessed["program"])
+
+    stdin_iter = iter(preprocessed["input"]) if preprocessed["input"] else iter(stdin_input)
+
+    pc = 0
+    cc = 0
+    cc_max = 0
+    cells = bytearray(1)
+    output = []
+
+    while True:
+        try:
+            command = compiled[pc][0]
+        except IndexError:
+            break
+
+        if command == "<" and cc > 0:
+            cc -= 1
+        elif command == ">":
+            cc += 1
+            if cc > cc_max:
+                cells.append(0)
+                cc_max += 1
+        elif command == "+":
+            if cells[cc] < 255:
+                cells[cc] += 1
+            else:
+                cells[cc] = 0
+        elif command == "-":
+            if cells[cc] > 0:
+                cells[cc] -= 1
+            else:
+                cells[cc] = 255
+        elif command == ".":
+            output.append(chr(cells[cc]))
+        elif command == ",":
+            if stdin_iter:
+                try:
+                    _ = next(stdin_iter)
+                except StopIteration:
+                    raise EOFError("More input required.")
+            else:
+                _ = "\0"
+            cells[cc] = ord(_)
+        elif command == "[" and cells[cc] == 0:
+            pc = compiled[pc][1]
+        elif command == "]" and cells[cc] != 0:
+            pc = compiled[pc][1]
+
+        pc += 1
+
+    return "".join(output)
