--- /dev/null
+++ b/pyfuck/braincopter_logic.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""
+Pure logic extracted from Braincopter class.
+No I/O, no class state — pure functions only.
+"""
+
+from pyfuck.brainloller_logic import to_brainfuck as brainloller_to_brainfuck
+
+
+COMMANDS = [
+    (255, 0, 0),
+    (128, 0, 0),
+    (0, 255, 0),
+    (0, 128, 0),
+    (0, 0, 255),
+    (0, 0, 128),
+    (255, 255, 0),
+    (128, 128, 0),
+    (0, 255, 255),
+    (0, 128, 128),
+    (0, 0, 0),
+]
+
+COMMANDS_REVERSE = [">", "<", "+", "-", ".", ",", "[", "]", "R", "L", None]
+COMMANDS_REVERSE_LEN = len(COMMANDS_REVERSE)
+
+
+def decode_pixel(r, g, b):
+    """
+    Decode a Braincopter pixel into its command index.
+
+    Args:
+        r, g, b: Colour components.
+
+    Returns:
+        The command index (0-10).
+    """
+    return (-2 * r + 3 * g + b) % 11
+
+
+def to_brainfuck(pixels, width, height):
+    """
+    Convert Braincopter image pixels to a Brainfuck program string.
+
+    Args:
+        pixels: 2D list of (R, G, B) tuples.
+        width: Image width.
+        height: Image height.
+
+    Returns:
+        A Brainfuck program string.
+    """
+    new_pixels = [[COMMANDS[decode_pixel(r, g, b)] for r, g, b in row] for row in pixels]
+    return brainloller_to_brainfuck(new_pixels, width, height)
+
+
+def find_similar(command, pixel):
+    """
+    Find a similar colour to the given pixel that encodes the desired command.
+
+    Args:
+        command: A Brainfuck command character (or None for NOP).
+        pixel: An (R, G, B) tuple.
+
+    Returns:
+        An (R, G, B) tuple with adjusted blue channel.
+    """
+    r, g, b = pixel
+    target_index = COMMANDS_REVERSE.index(command)
+    current_index = decode_pixel(r, g, b)
+    b += target_index - current_index
+    if b > 255:
+        b -= COMMANDS_REVERSE_LEN
+    elif b < 0:
+        b += COMMANDS_REVERSE_LEN
+    return (r, g, b)
