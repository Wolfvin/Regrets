{
  "build-result-record": {
    "entry": "buildResultRecord",
    "module": "wafw00f.main",
    "outputs": [
      {
        "input": [
          "https://example.com",
          "Cloudflare (Cloudflare Inc.)",
          "https://example.com/?xss=<script>"
        ],
        "output": {
          "url": "https://example.com",
          "detected": true,
          "trigger_url": "https://example.com/?xss=<script>",
          "firewall": "Cloudflare",
          "manufacturer": "Cloudflare Inc."
        }
      },
      {
        "input": [
          "https://example.com",
          "generic",
          "https://example.com/?xss=<script>"
        ],
        "output": {
          "url": "https://example.com",
          "detected": true,
          "trigger_url": "https://example.com/?xss=<script>",
          "firewall": "Generic",
          "manufacturer": "Unknown"
        }
      },
      {
        "input": [
          "https://example.com",
          null,
          null
        ],
        "output": {
          "url": "https://example.com",
          "trigger_url": null,
          "detected": false,
          "firewall": "None",
          "manufacturer": "None"
        }
      },
      {
        "input": [
          "https://test.org",
          "ModSecurity (SpiderLabs)",
          "https://test.org/?sqli=UNION"
        ],
        "output": {
          "url": "https://test.org",
          "detected": true,
          "trigger_url": "https://test.org/?sqli=UNION",
          "firewall": "ModSecurity",
          "manufacturer": "SpiderLabs"
        }
      }
    ]
  },
