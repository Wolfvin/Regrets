{
  "name": "regret-testing",
  "version": "1.0.0",
  "description": "Output-based regression testing for AI-driven refactoring — test the contract, not the implementation",
  "type": "module",
  "main": "index.js",
  "bin": {
    "regret": "./bin/regret.js"
  },
  "exports": {
    ".": "./index.js",
    "./fingerprint": "./scripts/fingerprint.js",
    "./ghost": "./scripts/ghost.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "pretest": "npm run build --workspace mcp",
    "test:integration": "node scripts/test.mjs",
    "regret": "node scripts/regret.js"
  },
  "keywords": [
    "regression-testing",
    "snapshot-testing",
    "refactoring",
    "fingerprint",
    "ghost-proxy"
  ],
  "files": [
    "scripts/",
    "bin/",
    "index.js",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "mcp"
  ],
  "dependencies": {
    "chokidar": "^5.0.0",
    "web-tree-sitter": "^0.26.9"
  },
  "devDependencies": {
    "postcss": "^8.5.15",
    "vue": "^3.5.0",
    "@vue/server-renderer": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
